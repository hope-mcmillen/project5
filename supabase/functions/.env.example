# Copy to supabase/functions/.env (gitignored) for local `supabase functions serve`.
# Deployed values are set with `supabase secrets set`, never committed.

# mock | gemini   (gemini arrives in B3; PRD §9.3)
LLM_PROVIDER=mock

# Google AI Studio key. Paste only into your local .env, never into code or chat.
GEMINI_API_KEY=
# Any current Flash-class model; verify the name in AI Studio.
LLM_EXTRACT_MODEL=gemini-3.8-flash
# Pinned: changing it means re-embedding everything (PRD §9.3).
LLM_EMBED_MODEL=gemini-embedding-001

LLM_DAILY_TOKEN_BUDGET=200000

# Public origin for signed resume links (Android emulator: http://10.0.2.2:54321).
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
